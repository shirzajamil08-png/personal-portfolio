# Copy this file to server/.env and fill in your own values.
# server/.env is git-ignored - never commit real credentials.

# MongoDB Atlas connection string.
# Atlas -> your cluster -> Connect -> Drivers -> copy the string,
# then replace <password> with your database user's password and add a db name.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# Port the API listens on
PORT=5000

# Which origin is allowed to call the API (the React dev server in development)
CLIENT_ORIGIN=http://localhost:5173

# Any long random string. Required for the admin routes:
#   GET /api/messages, POST/PUT/DELETE /api/projects
# Send it as the x-admin-key header.
ADMIN_KEY=change-this-to-a-long-random-string

# Set to "production" when deploying so the API also serves client/dist
NODE_ENV=development
